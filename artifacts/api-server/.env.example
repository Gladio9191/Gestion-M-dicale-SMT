# Runtime variables only. Never commit the real values or copy these into VITE_*.
NODE_ENV=development
PORT=3001
DATABASE_URL=
SMT_OWNER_PASSWORD_HASH=
# Exact trusted frontend origin(s), comma-separated; no wildcard
SMT_ALLOWED_ORIGINS=
# Set secure=true and HTTPS before deploying any remote API.
SMT_COOKIE_SECURE=false
# strict for same-site. Cross-site HTTPS requires none, secure cookies and explicit trusted origins.
SMT_COOKIE_SAME_SITE=strict
# Fiche Engine must bind to localhost or private network; do not expose its port.
FICHE_ENGINE_PORT=5000
