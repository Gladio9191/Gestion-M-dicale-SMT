{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "if [ \"$VERCEL_ENV\" = \"preview\" ]; then VITE_SMT_VISUAL_PREVIEW=1 VITE_API_BASE_URL= PORT=18971 BASE_PATH=/ pnpm --filter @workspace/fiche-medicale run build; else PORT=18971 BASE_PATH=/ pnpm --filter @workspace/fiche-medicale run build; fi",
  "outputDirectory": "artifacts/fiche-medicale/dist/public",
  "rewrites": [
    {
      "source": "/employees",
      "destination": "/index.html"
    },
    {
      "source": "/employees/new",
      "destination": "/index.html"
    },
    {
      "source": "/employees/:matricule",
      "destination": "/index.html"
    },
    {
      "source": "/import",
      "destination": "/index.html"
    },
    {
      "source": "/import/multi-feuilles",
      "destination": "/index.html"
    },
    {
      "source": "/generer",
      "destination": "/index.html"
    },
    {
      "source": "/registre",
      "destination": "/index.html"
    },
    {
      "source": "/hygiene/new",
      "destination": "/index.html"
    },
    {
      "source": "/hygiene/historique",
      "destination": "/index.html"
    },
    {
      "source": "/expertises",
      "destination": "/index.html"
    },
    {
      "source": "/pointage",
      "destination": "/index.html"
    },
    {
      "source": "/evaluation",
      "destination": "/index.html"
    }
  ]
}
